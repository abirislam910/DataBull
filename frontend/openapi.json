        ],
        "summary": "Alerts",
        "description": "Threshold breaches since a given instant, newest first.",
        "operationId": "alerts_readings_alerts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Limit"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Since"
            }
          },
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Device Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertResponse"
                  },
                  "title": "Response Alerts Readings Alerts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AggregateBucket": {
        "properties": {
          "bucket": {
            "type": "string",
            "format": "date-time",
            "title": "Bucket"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "bucket",
          "value"
        ],
        "title": "AggregateBucket",
        "description": "One row of `GET /readings/aggregate` \u2192 `{bucket, value}`."
      },
      "AggregateFn": {
        "type": "string",
        "enum": [
          "avg",
          "min",
          "max",
          "p95"
        ],
        "title": "AggregateFn",
        "description": "Rollup functions accepted by `GET /readings/aggregate`."
      },
      "AggregateWindow": {
        "type": "string",
        "enum": [
          "1h",
          "1d",
          "1w"
        ],
        "title": "AggregateWindow",
        "description": "Bucket widths accepted by `GET /readings/aggregate`."
      },
      "AlertResponse": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "device_name": {
            "type": "string",
            "title": "Device Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "bound": {
            "type": "string",
            "enum": [
              "min",
              "max"
            ],
            "title": "Bound"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "device_name",
          "unit",
          "time",
          "value",
          "bound",
          "threshold"
        ],
        "title": "AlertResponse",
        "description": "A reading that breached one of its device's configured thresholds.\n\nAlerts are *derived*, not stored: there is no alerts table. Each response is\ncomputed by comparing readings against the owning device's thresholds at\nquery time, which means editing a threshold retroactively changes what\ncounts as an alert.\n\nCarries `device_name` and `unit` so the row is self-describing \u2014 the AI\nassistant is required to cite device names, and making it join that back\nitself would be wasted round-trips."
      },
      "BulkReadingCreate": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          }
        },
        "type": "object",
        "required": [
          "value",
          "time"
        ],
        "title": "BulkReadingCreate",
        "description": "One item of `POST /devices/{device_id}/readings/bulk`.\n\nUnlike the single-reading body, `time` is REQUIRED here. Defaulting a whole\nbatch to \"now\" would give every row the same timestamp, and since the\nprimary key is (time, device_id) the batch would collide with itself \u2014 a\nconfusing 409 for what looks like valid input. Bulk uploads are backfills;\nthey know their timestamps."
      },
      "BulkReadingsResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "BulkReadingsResponse",
        "description": "`POST /devices/{device_id}/readings/bulk` \u2192 `{count}`."
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "description": "Shared body for signup and login: `{email, password}`."
      },
      "DeleteAccountRequest": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "DeleteAccountRequest"
      },
      "DeleteReadingsResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
